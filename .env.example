# ---------------------------------------------------------------------
# LLM provider (any OpenAI-compatible endpoint)
# ---------------------------------------------------------------------
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=changeme

# Model used to SYNTHESISE ANSWERS. Shared by both pipelines — this is what
# makes the comparison fair. Change it and both sides change together.
LLM_MODEL=qwen3-coder:30b

# Model used for entity/relationship extraction (Semantic RAG ingest only).
LLM_EXTRACTION_MODEL=qwen3-coder:30b

# Embedding model. Shared by both pipelines.
EMBEDDING_MODEL=bge-m3:latest

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=180
LLM_MAX_RETRIES=5
LLM_RETRY_BASE_DELAY=2.0


# =====================================================================
# PROVIDER RECIPES
#
# Any OpenAI-compatible endpoint works. Note that most free CHAT APIs
# serve no embedding model, which is why the embedding backend is
# configured separately and can run locally with no key.
# ---------------------------------------------------------------------
# Groq (free, no card) -- chat only, so embeddings run locally:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_your_key_here
#   LLM_MODEL=llama-3.3-70b-versatile
#   LLM_EXTRACTION_MODEL=llama-3.3-70b-versatile
#   EMBEDDING_PROVIDER=local
#   CF_ACCESS_CLIENT_ID=          (leave blank)
#   CF_ACCESS_CLIENT_SECRET=      (leave blank)
#
# OpenRouter (free ':free' models) -- chat only, embeddings local:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-v1-...
#   LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   EMBEDDING_PROVIDER=local
#
# Mistral -- serves BOTH chat and embeddings, nothing runs locally:
#   LLM_BASE_URL=https://api.mistral.ai/v1
#   LLM_API_KEY=...
#   LLM_MODEL=mistral-small-latest
#   EMBEDDING_PROVIDER=api
#   EMBEDDING_MODEL=mistral-embed
#
# Local Ollama -- no key at all:
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=qwen2.5:7b
#   EMBEDDING_PROVIDER=api
#   EMBEDDING_MODEL=bge-m3:latest
# =====================================================================

# ---------------------------------------------------------------------
# Embedding backend
# ---------------------------------------------------------------------
# "api"   = OpenAI-compatible /v1/embeddings endpoint
# "local" = fastembed, in-process, NO API KEY REQUIRED
EMBEDDING_PROVIDER=api

# Only used when EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional: point embeddings at a different provider than chat.
# Blank means "same endpoint/key as chat".
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# ---------------------------------------------------------------------
# Cloudflare Access service token (leave blank if your gateway is open)
# ---------------------------------------------------------------------
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# ---------------------------------------------------------------------
# Retrieval settings (identical corpus, tune each side independently)
# ---------------------------------------------------------------------
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=5
GRAPH_MAX_HOPS=5
GRAPH_MAX_SEEDS=6
ENTITY_LINK_THRESHOLD=0.45

# Fall back to a deterministic regex extractor if the LLM is unreachable,
# so the demo still boots offline.
ALLOW_EXTRACTION_FALLBACK=true

CORS_ORIGINS=*
